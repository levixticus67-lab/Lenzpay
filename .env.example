# API service
NODE_ENV=development
PORT=3000
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Admin login. Generate ADMIN_PASSWORD_HASH with `npm run admin:hash`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CLIENT_SECRET_PEPPER=

# Ledger and payment limits (UGX)
DEVELOPER_COMMISSION_RATE=0.025
AGENCY_COMMISSION_WALLET_MSISDN=256770000000
MIN_PAYMENT_AMOUNT=100
MAX_PAYMENT_AMOUNT=10000000
PAYMENT_WEBHOOK_BASE_URL=

# MTN MoMo Collection API
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENV=sandbox

# Airtel Money Collection API
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENV=sandbox
